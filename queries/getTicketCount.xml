<query id="getTicketCount" action="select">
    <tables>
        <table name="a_mission_tickets" />
    </tables>
    <columns>
        <column name="ticket_count" />
    </columns>
    <conditions>
        <condition operation="equal" column="member_srl" var="member_srl" notnull="notnull" />
    </conditions>
</query>
