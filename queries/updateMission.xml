<query id="updateMission" action="update">
    <tables>
        <table name="a_mission_missions" />
    </tables>
    <columns>
        <column name="title" var="title" />
        <column name="description" var="description" />
        <column name="mission_type" var="mission_type" />
        <column name="conditions" var="conditions" />
        <column name="reward_tickets" var="reward_tickets" />
        <column name="reset_cycle" var="reset_cycle" />
        <column name="is_active" var="is_active" />
        <column name="start_date" var="start_date" />
        <column name="end_date" var="end_date" />
    </columns>
    <conditions>
        <condition operation="equal" column="mission_srl" var="mission_srl" notnull="notnull" />
    </conditions>
</query>
