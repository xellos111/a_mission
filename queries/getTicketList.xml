<query id="getTicketList" action="select">
    <tables>
        <table name="member" alias="member" />
        <table name="a_mission_tickets" alias="tickets" type="left join">
            <conditions>
                <condition operation="equal" column="member_srl" default="member.member_srl" />
            </conditions>
        </table>
    </tables>
    <columns>
        <column name="member.*" />
        <column name="tickets.ticket_count" />
        <column name="tickets.last_update" />
    </columns>
    <conditions>
        <condition operation="like" column="member.user_id" var="s_user_id" />
        <condition operation="like" column="member.nick_name" var="s_nick_name" pipe="or" />
    </conditions>
    <navigation>
        <index var="sort_index" default="member.member_srl" order="desc" />
        <list_count var="list_count" default="20" />
        <page_count var="page_count" default="10" />
        <page var="page" default="1" />
    </navigation>
</query>
